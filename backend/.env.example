# Django Configuration
SECRET_KEY=replace-with-a-strong-random-secret-key
DEBUG=True

# Hugging Face Hosted Inference Configuration (https://huggingface.co/settings/tokens)
# Create a free User Access Token with "Make calls to Inference Providers" permission.
HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions
HF_TOKEN=
# Verified active vision model on Hugging Face router (supports image+text input)
HF_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Verified active chat model on Hugging Face router
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
